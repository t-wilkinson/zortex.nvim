# Copy to .env (docker compose reads it)

# Synced notes folder on the host
NOTES_PATH=./notes

# ntfy: public ntfy.sh or self-hosted. Required: a private, hard-to-guess
# topic (anyone who knows a topic on a public server can read it)
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_AUTH_TOKEN=

# Optional shared secret for /notify and /pending (plugin: server.api_key)
ZORTEX_API_KEY=

# The calendar's time zone (unset: UTC)
TZ=America/New_York
